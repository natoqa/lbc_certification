---
/*
  Contact — Final CTA section. 100% WhatsApp-focused.
  No contact form — per client requirements.
  Large WhatsApp button, specialist availability text, placeholder for business hours.
*/
---

<section id="contacto" class="section-padding bg-navy-900 relative overflow-hidden">
  <!-- Subtle pattern -->
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true">
    <div class="w-full h-full" style="background-image: linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 3rem 3rem;"></div>
  </div>
  
  <!-- Seal watermark -->
  <div class="absolute -right-16 -bottom-16 w-72 h-72 opacity-[0.03]" aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="100" cy="100" r="95" stroke="white" stroke-width="1.5"/>
      <circle cx="100" cy="100" r="85" stroke="white" stroke-width="0.75"/>
      <circle cx="100" cy="100" r="75" stroke="white" stroke-width="0.5"/>
    </svg>
  </div>

  <div class="relative max-w-3xl 2xl:max-w-5xl 3xl:max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12 text-center" data-animate-group>
    
    <div class="inline-flex items-center gap-2 mb-6 px-4 py-1.5 rounded-full border border-gold-500/30 bg-gold-500/5" data-animate="fade-in" data-animate-order="0">
      <span class="w-1.5 h-1.5 rounded-full bg-gold-500 animate-pulse" aria-hidden="true"></span>
      <span class="text-gold-400 text-xs font-semibold tracking-widest uppercase font-sans">Contacto directo</span>
    </div>

    <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl text-white mb-4" data-reveal data-animate-order="1">
      Inicie su proceso de certificación hoy
    </h2>
    
    <p class="text-silver-300 text-base sm:text-lg 2xl:text-xl max-w-xl 2xl:max-w-3xl mx-auto mb-8 font-sans leading-relaxed" data-reveal-words data-animate-order="2">
      Escríbanos por WhatsApp y un especialista analizará sus necesidades. Le enviaremos una propuesta técnica y económica adaptada a su organización, sin compromiso.
    </p>

    <!-- Large WhatsApp CTA -->
    <a 
      href="https://wa.me/51913233177" 
      target="_blank" 
      rel="noopener noreferrer"
      class="btn-primary text-lg font-bold px-10 py-5 gap-3"
      id="contact-cta-whatsapp"
      data-animate="fade-up"
      data-animate-order="3"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Escríbanos por WhatsApp
    </a>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-6 text-silver-400 text-sm font-sans" data-animate="fade-in" data-animate-order="4">
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
        </svg>
        <span>+51 913 233 177</span>
      </div>
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>Lunes a Domingo · Atención 24/7</span>
      </div>
    </div>

  </div>
</section>
