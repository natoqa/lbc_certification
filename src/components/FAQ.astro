---
/*
  FAQ — 6 Q&A accordion items. Uses <details>/<summary> for native accessibility.
  Grid-paper background pattern for audit-worksheet feel.
  Content matches brief exactly — no rewrites.
*/

const faqs = [
  {
    question: "¿Cuánto cuesta obtener una certificación ISO?",
    answer: "El costo se determina de acuerdo con la norma, el número de trabajadores, las sedes, el alcance del sistema de gestión y la complejidad de la organización. Elaboramos una cotización personalizada sin compromiso."
  },
  {
    question: "¿Cuánto tiempo demora el proceso de certificación?",
    answer: "Depende del nivel de preparación de la organización y del alcance de la certificación. Una vez aceptada la propuesta, coordinamos el plan de auditoría y las fechas de ejecución de manera ágil."
  },
  {
    question: "¿Qué requisitos debo cumplir antes de certificarme?",
    answer: "La organización debe contar con un sistema de gestión implementado y operativo antes de iniciar el proceso de certificación."
  },
  {
    question: "¿La certificación tiene reconocimiento internacional?",
    answer: "Nuestras certificaciones se desarrollan conforme a normas internacionales ISO, aplicando principios de imparcialidad, independencia y competencia técnica en todo el proceso de evaluación. Si su organización requiere una certificación con alcance de acreditación específico, coordinamos con usted los detalles según su necesidad."
  },
  {
    question: "¿Qué sucede si se identifican no conformidades durante la auditoría?",
    answer: "Se otorga un plazo para implementar las acciones correctivas correspondientes. Una vez verificadas y aceptadas, el proceso continúa hasta la decisión de certificación."
  },
  {
    question: "¿Cómo puedo iniciar el proceso?",
    answer: "Escríbanos por WhatsApp. Un especialista analizará sus necesidades y le enviará una propuesta técnica y económica adaptada a su organización."
  }
];
---

<section id="preguntas-frecuentes" class="section-padding bg-white relative">
  <!-- Grid paper background (audit worksheet motif) -->
  <div class="absolute inset-0 grid-paper opacity-40 pointer-events-none" aria-hidden="true"></div>
  
  <div class="relative max-w-3xl 2xl:max-w-5xl 3xl:max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12" data-animate-group>
    
    <div class="text-center mb-12">
      <span class="text-gold-500 text-xs font-semibold tracking-widest uppercase font-sans mb-3 block" data-animate="fade-in" data-animate-order="0">Preguntas frecuentes</span>
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl text-navy-900" data-reveal data-animate-order="1">
        Resolvemos sus dudas sobre certificación
      </h2>
    </div>

    <div class="flex flex-col gap-3" data-animate-order="2" data-animate-stagger="60">
      {faqs.map((faq, index) => (
        <details class="faq-item group bg-white rounded-lg border border-silver-200 overflow-hidden hover:border-silver-300 transition-colors" data-animate="fade-up">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 font-sans font-semibold text-navy-900 text-base sm:text-[1.0625rem]">
            <span>{faq.question}</span>
            <svg class="faq-chevron w-5 h-5 text-silver-400 group-hover:text-gold-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="px-6 pb-5 pt-0">
            <p class="text-navy-900/65 text-[0.9375rem] leading-relaxed font-sans border-t border-silver-100 pt-4">
              {faq.answer}
            </p>
          </div>
        </details>
      ))}
    </div>

    <!-- Highlighted FAQ Support Card -->
    <div class="mt-12 rounded-2xl bg-navy-900 text-white p-6 sm:p-8 relative overflow-hidden shadow-xl border border-gold-500/20" data-animate="fade-up" data-animate-order="3">
      <!-- Subtle background pattern -->
      <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true">
        <div class="w-full h-full" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 2.5rem 2.5rem;"></div>
      </div>
      <div class="absolute -right-12 -bottom-12 w-48 h-48 bg-gold-500/10 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <div class="shrink-0 w-12 h-12 rounded-full bg-gold-500/15 border border-gold-500/30 flex items-center justify-center text-gold-400">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-serif text-lg sm:text-xl text-white font-normal">¿Tiene otra consulta?</h3>
            <p class="text-silver-300 text-sm font-sans mt-0.5">
              Un especialista resolverá todas sus dudas de manera inmediata.
            </p>
          </div>
        </div>

        <a 
          href="https://wa.me/51913233177" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn-primary text-sm sm:text-base px-6 py-3 shrink-0 shadow-md inline-flex items-center gap-2.5"
          id="faq-cta-whatsapp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escríbanos por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
