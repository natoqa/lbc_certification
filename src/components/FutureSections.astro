---
/*
  FutureSections — Placeholder sections for content the client will complete later:
  - Casos de éxito / Proyectos
  - Testimonios de clientes
  - Presentación del equipo
  All are clearly marked as placeholder content, responsive and ready to populate.
*/
---

<!-- Future Content Sections -->
<div class="bg-navy-50">
  
  <!-- Casos de éxito -->
  <section id="casos-de-exito" class="section-padding">
    <div class="max-w-6xl 2xl:max-w-[90rem] 3xl:max-w-[110rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12">
      <div class="text-center mb-10">
        <span class="text-gold-500 text-xs font-semibold tracking-widest uppercase font-sans mb-3 block">Casos de éxito</span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl text-navy-900" data-reveal>
          Proyectos y organizaciones certificadas
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 3xl:grid-cols-4 gap-6">
        {[1, 2, 3].map(() => (
          <div class="border-2 border-dashed border-silver-300 rounded-lg p-8 flex flex-col items-center justify-center text-center min-h-[14rem]">
            <div class="w-12 h-12 rounded-full bg-silver-100 flex items-center justify-center mb-4">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#9CA8B7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
            <span class="text-silver-400 text-sm font-sans font-semibold">Próximamente</span>
            <span class="text-silver-300 text-xs font-sans mt-1">Caso de éxito — pendiente</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section id="testimonios" class="section-padding bg-white">
    <div class="max-w-5xl 2xl:max-w-[85rem] 3xl:max-w-[100rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12">
      <div class="text-center mb-10">
        <span class="text-gold-500 text-xs font-semibold tracking-widest uppercase font-sans mb-3 block">Testimonios</span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl text-navy-900" data-reveal>
          Lo que dicen nuestros clientes
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {[1, 2].map(() => (
          <div class="border-2 border-dashed border-silver-300 rounded-lg p-8 text-center min-h-[12rem] flex flex-col items-center justify-center">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9CA8B7" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mb-4 opacity-40">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
            </svg>
            <span class="text-silver-400 text-sm font-sans font-semibold">Próximamente</span>
            <span class="text-silver-300 text-xs font-sans mt-1">Testimonio de cliente — pendiente</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Equipo -->
  <section id="equipo" class="section-padding">
    <div class="max-w-5xl 2xl:max-w-[85rem] 3xl:max-w-[100rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12">
      <div class="text-center mb-10">
        <span class="text-gold-500 text-xs font-semibold tracking-widest uppercase font-sans mb-3 block">Nuestro equipo</span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl text-navy-900" data-reveal>
          Profesionales comprometidos con la excelencia
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[1, 2, 3, 4].map(() => (
          <div class="border-2 border-dashed border-silver-300 rounded-lg p-6 flex flex-col items-center justify-center text-center min-h-[14rem]">
            <div class="w-16 h-16 rounded-full bg-silver-100 flex items-center justify-center mb-4">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#9CA8B7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <span class="text-silver-400 text-sm font-sans font-semibold">Próximamente</span>
            <span class="text-silver-300 text-xs font-sans mt-1">Miembro del equipo — pendiente</span>
          </div>
        ))}
      </div>
    </div>
  </section>

</div>
