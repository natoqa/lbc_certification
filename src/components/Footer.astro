---
/*
  Footer — LBC Certification name, RUC placeholder, anchor links, legal placeholders.
  Navy-900 background with border-top accent.
*/
---

<footer class="bg-navy-900 border-t border-navy-700 text-silver-400">
  <div class="max-w-6xl 2xl:max-w-[90rem] 3xl:max-w-[110rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12 py-12 2xl:py-16" data-animate-group>
    
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-10" data-animate-order="0" data-animate-stagger="100">
      
      <!-- Brand Column -->
      <div class="sm:col-span-2 lg:col-span-1" data-animate="fade-up">
        <div class="flex items-center gap-3 mb-4">
          <img 
            src="/images/Logo.png" 
            alt="LBC Certification" 
            width="480" 
            height="180"
            class="h-15 sm:h-16 w-auto object-contain opacity-90"
            loading="lazy"
          />
        </div>
        <p class="text-sm leading-relaxed mb-4 font-sans" data-reveal-words>
          Organismo de certificación de sistemas de gestión bajo normas internacionales ISO, con cobertura a nivel nacional.
        </p>
        <div class="text-xs text-silver-400/60 font-sans space-y-1">
          <p>Razón social: <span class="text-silver-300">LBC CERTIFICATION S.A.C.</span></p>
          <p>RUC: <span class="text-silver-300">20616315405</span></p>
        </div>
      </div>

      <!-- Navigation Column -->
      <div data-animate="fade-up">
        <h4 class="text-white font-sans font-semibold text-sm tracking-wider uppercase mb-4">Navegación</h4>
        <nav class="flex flex-col gap-2.5" aria-label="Enlaces del footer">
          <a href="#nosotros" class="text-sm font-sans hover:text-white transition-colors">Nosotros</a>
          <a href="#servicios" class="text-sm font-sans hover:text-white transition-colors">Servicios</a>
          <a href="#por-que-elegirnos" class="text-sm font-sans hover:text-white transition-colors">Por qué elegirnos</a>
          <a href="#casos-de-exito" class="text-sm font-sans hover:text-white transition-colors">Casos de éxito</a>
          <a href="#equipo" class="text-sm font-sans hover:text-white transition-colors">Equipo</a>
          <a href="#preguntas-frecuentes" class="text-sm font-sans hover:text-white transition-colors">Preguntas frecuentes</a>
          <a href="#contacto" class="text-sm font-sans hover:text-white transition-colors">Contacto</a>
        </nav>
      </div>

      <!-- Services Quick Links Column -->
      <div data-animate="fade-up">
        <h4 class="text-white font-sans font-semibold text-sm tracking-wider uppercase mb-4">Certificaciones</h4>
        <nav class="flex flex-col gap-2.5" aria-label="Certificaciones ISO">
          <a href="#servicios" class="text-sm font-sans hover:text-white transition-colors">ISO 9001</a>
          <a href="#servicios" class="text-sm font-sans hover:text-white transition-colors">ISO 14001</a>
          <a href="#servicios" class="text-sm font-sans hover:text-white transition-colors">ISO 45001</a>
          <a href="#servicios" class="text-sm font-sans hover:text-white transition-colors">ISO 37001</a>
          <a href="#servicios" class="text-sm font-sans hover:text-white transition-colors">ISO 22000 / HACCP</a>
        </nav>
      </div>

      <!-- Contact Column -->
      <div data-animate="fade-up">
        <h4 class="text-white font-sans font-semibold text-sm tracking-wider uppercase mb-4">Contacto</h4>
        <div class="flex flex-col gap-3">
          <a 
            href="https://wa.me/51913233177" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm font-sans hover:text-white transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            +51 913 233 177
          </a>
          <a 
            href="https://wa.me/51913233177" 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn-cta-header mt-2 justify-center text-center w-fit"
          >
            Solicite cotización
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-navy-700 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-silver-400/60 font-sans" data-animate="fade-in" data-animate-order="1">
      <p>© {new Date().getFullYear()} LBC Certification S.A.C. Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <!-- Placeholder legal links — client to provide actual pages -->
        <a href="#" class="hover:text-silver-300 transition-colors">Aviso legal</a>
        <span class="text-silver-400/30">|</span>
        <a href="#" class="hover:text-silver-300 transition-colors">Política de privacidad</a>
      </div>
    </div>
  </div>
</footer>
