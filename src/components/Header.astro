---
/* 
  Header — Fixed navigation with scroll-aware background.
  Transparent over hero, solid navy-900 on scroll.
  Mobile hamburger menu for responsive nav.
*/
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300">
  <a href="#contenido-principal" class="skip-link">Ir al contenido principal</a>
  
  <div class="max-w-7xl 2xl:max-w-[90rem] 3xl:max-w-[110rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12">
    <div class="flex items-center justify-between h-[5rem] sm:h-[5.5rem] md:h-[5.5rem] lg:h-[5.5rem] 2xl:h-[6rem] 32inch:h-[7rem] transition-all duration-300">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0 py-1" aria-label="LBC Certification — Inicio">
        <img 
          src="/images/Logo.png" 
          alt="LBC Certification" 
          width="240" 
          height="100" 
          class="h-20 sm:h-24 md:h-22 lg:h-28 2xl:h-36 32inch:h-40 w-auto object-contain transition-all duration-300"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8 32inch:gap-12" aria-label="Navegación principal">
        <a href="#nosotros" class="nav-link text-sm xl:text-base 2xl:text-lg 32inch:text-xl font-semibold tracking-wide text-white/80 hover:text-white transition-colors">Nosotros</a>
        <a href="#servicios" class="nav-link text-sm xl:text-base 2xl:text-lg 32inch:text-xl font-semibold tracking-wide text-white/80 hover:text-white transition-colors">Servicios</a>
        <a href="#casos-de-exito" class="nav-link text-sm xl:text-base 2xl:text-lg 32inch:text-xl font-semibold tracking-wide text-white/80 hover:text-white transition-colors">Casos de éxito</a>
        <a href="#equipo" class="nav-link text-sm xl:text-base 2xl:text-lg 32inch:text-xl font-semibold tracking-wide text-white/80 hover:text-white transition-colors">Equipo</a>
        <a href="#contacto" class="nav-link text-sm xl:text-base 2xl:text-lg 32inch:text-xl font-semibold tracking-wide text-white/80 hover:text-white transition-colors">Contacto</a>
        <a 
          href="https://wa.me/51913233177" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn-cta-header 32inch:px-6 32inch:py-3.5 32inch:text-base 32inch:gap-2.5"
          aria-label="Cotice aquí por WhatsApp"
        >
          <svg width="16" height="16" class="32inch:w-5 32inch:h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Cotice aquí
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn" 
        class="lg:hidden flex flex-col gap-1.5 p-2 -mr-2" 
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-white transition-all duration-200 origin-center" id="bar1"></span>
        <span class="block w-6 h-0.5 bg-white transition-all duration-200" id="bar2"></span>
        <span class="block w-6 h-0.5 bg-white transition-all duration-200 origin-center" id="bar3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div 
    id="mobile-menu" 
    class="mobile-menu lg:hidden flex-col bg-navy-900/98 backdrop-blur-md border-t border-white/10"
    aria-label="Menú de navegación móvil"
  >
    <nav class="flex flex-col px-6 py-6 gap-1">
      <a href="#nosotros" class="mobile-nav-link py-3 text-base font-semibold text-white/80 hover:text-white transition-colors border-b border-white/5">Nosotros</a>
      <a href="#servicios" class="mobile-nav-link py-3 text-base font-semibold text-white/80 hover:text-white transition-colors border-b border-white/5">Servicios</a>
      <a href="#casos-de-exito" class="mobile-nav-link py-3 text-base font-semibold text-white/80 hover:text-white transition-colors border-b border-white/5">Casos de éxito</a>
      <a href="#equipo" class="mobile-nav-link py-3 text-base font-semibold text-white/80 hover:text-white transition-colors border-b border-white/5">Equipo</a>
      <a href="#contacto" class="mobile-nav-link py-3 text-base font-semibold text-white/80 hover:text-white transition-colors">Contacto</a>
      <a 
        href="https://wa.me/51913233177" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn-primary mt-4 justify-center"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Cotice aquí
      </a>
    </nav>
  </div>
</header>

<script>
  // Scroll-aware header background
  const header = document.getElementById('site-header');
  const handleScroll = () => {
    if (window.scrollY > 60) {
      header?.classList.add('bg-navy-900/95', 'backdrop-blur-md', 'shadow-lg', 'shadow-navy-900/20');
    } else {
      header?.classList.remove('bg-navy-900/95', 'backdrop-blur-md', 'shadow-lg', 'shadow-navy-900/20');
    }
  };
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('active');
    mobileMenu?.classList.toggle('active');
    menuBtn?.setAttribute('aria-expanded', String(!isOpen));
    
    if (!isOpen) {
      bar1?.classList.add('rotate-45', 'translate-y-[4px]');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-rotate-45', '-translate-y-[4px]');
    } else {
      bar1?.classList.remove('rotate-45', 'translate-y-[4px]');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-[4px]');
    }
  });

  // Close mobile menu on anchor click
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('active');
      menuBtn?.setAttribute('aria-expanded', 'false');
      bar1?.classList.remove('rotate-45', 'translate-y-[4px]');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-[4px]');
    });
  });
</script>
