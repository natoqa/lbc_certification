---
/*
  SuccessCases — 7 Casos de éxito de clientes en diversos sectores:
  Importación de equipos médicos, Fabricación de mobiliario, Constructoras/Trinorma,
  Minería, Remediación ambiental, Servicios generales y Empresas conexas a minería.
*/

const cases = [
  {
    sector: "Sector Salud",
    activity: "Importación, venta e instalación de equipos médicos",
    context: "Acompañamiento en procesos de certificación para empresas del sector salud, con altos requisitos de trazabilidad y cumplimiento normativo.",
    quote: "La certificación nos ayudó a estandarizar procesos y a fortalecer nuestra posición para cerrar contratos de gran envergadura."
  },
  {
    sector: "Manufactura & Mobiliario",
    activity: "Fabricación y venta de mobiliario",
    context: "Certificación de sistemas de gestión en procesos de manufactura y comercialización.",
    quote: "Gracias a la certificación cerramos contratos a largo plazo que sostuvieron a todo nuestro equipo durante años. Seguimos con el seguimiento ISO de forma permanente."
  },
  {
    sector: "Construcción",
    activity: "Constructoras de proyectos de gran envergadura",
    context: "Certificación de sistemas de gestión bajo la trinorma (ISO 9001, 14001 y 45001) para el desarrollo de proyectos de mayor escala.",
    quote: "La certificación fue la puerta de entrada a proyectos de gran envergadura, con cumplimiento total de la trinorma."
  },
  {
    sector: "Minería",
    activity: "Pequeña y mediana minería",
    context: "Fortalecimiento de la imagen institucional y el compromiso ambiental y de seguridad de operaciones mineras a nivel nacional.",
    quote: "La certificación nos dio un plus en sostenibilidad frente a nuestros compradores de mineral."
  },
  {
    sector: "Remediación Ambiental",
    activity: "Proyectos de remediación ambiental",
    context: "Certificación de sistemas de gestión para organizaciones ejecutoras de proyectos de remediación ambiental.",
    quote: "Participamos en proyectos con un enfoque real de preservación de flora y fauna, respaldados por nuestra certificación."
  },
  {
    sector: "Servicios Generales",
    activity: "Mantenimiento general y servicios generales",
    context: "Acompañamiento en el proceso de certificación para empresas de mantenimiento y servicios generales.",
    quote: "Ampliamos nuestra cartera de clientes y robustecimos nuestros estándares frente a la competencia."
  },
  {
    sector: "Proveedores Mineros",
    activity: "Empresas conexas al sector minero",
    context: "Certificación de proveedores y contratistas que operan alrededor de la actividad minera.",
    quote: "Logramos cerrar contratos con empresas mineras importantes en Perú y robustecer nuestro sistema de gestión de SST y medio ambiente."
  }
];
---

<section id="casos-de-exito" class="section-padding bg-navy-50 relative overflow-hidden">
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true">
    <div class="w-full h-full" style="background-image: linear-gradient(rgba(19,46,91,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(19,46,91,0.3) 1px, transparent 1px); background-size: 3rem 3rem;"></div>
  </div>

  <div class="relative max-w-7xl 2xl:max-w-[90rem] 3xl:max-w-[110rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12" data-animate-group>
    
    <div class="text-center mb-14">
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 mb-4 px-4 py-1.5 rounded-full border border-gold-500/30 bg-gold-500/10 shadow-sm" data-animate="fade-in" data-animate-order="0">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-500 animate-pulse" aria-hidden="true"></span>
        <span class="text-gold-600 text-xs 2xl:text-sm font-bold tracking-widest uppercase font-sans">Casos de éxito</span>
      </div>

      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl text-navy-900 mb-4" data-reveal data-animate-order="1">
        Proyectos y organizaciones certificadas
      </h2>
      <p class="text-navy-900/65 text-base sm:text-lg 2xl:text-xl max-w-3xl mx-auto font-sans leading-relaxed" data-reveal-words data-animate-order="2">
        Acompañamos a empresas de diversos sectores en su camino hacia la excelencia operativa y la competitividad en el mercado.
      </p>
    </div>

    <!-- Cases Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8" data-animate-order="3" data-animate-stagger="70">
      {cases.map((item) => (
        <article class="bg-white rounded-xl p-6 sm:p-8 border border-silver-200/80 shadow-sm hover:shadow-lg hover:border-gold-500/40 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden" data-animate="scale-in">
          
          <!-- Top subtle accent line on hover -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold-500/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <div>
            <!-- Sector Pill & Quote Icon -->
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold font-sans bg-navy-50 text-navy-900 border border-silver-200">
                {item.sector}
              </span>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-gold-500/40 group-hover:text-gold-500 transition-colors shrink-0" aria-hidden="true">
                <path d="M10 11H6a3 3 0 0 1 3-3V6a5 5 0 0 0-5 5v7a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-5a2 2 0 0 0-2-2zm10 0h-4a3 3 0 0 1 3-3V6a5 5 0 0 0-5 5v7a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-5a2 2 0 0 0-2-2z" fill="currentColor"/>
              </svg>
            </div>

            <!-- Activity & Scope -->
            <h3 class="font-serif text-lg text-navy-900 mb-2 leading-snug">
              {item.activity}
            </h3>
            
            <p class="text-navy-900/60 text-xs sm:text-sm font-sans mb-5 leading-relaxed">
              {item.context}
            </p>
          </div>

          <!-- Testimonial Quote Block -->
          <blockquote class="text-navy-800 text-sm sm:text-base font-sans leading-relaxed italic border-l-2 border-gold-500/50 pl-4 bg-navy-50/50 py-3 rounded-r mt-2">
            "{item.quote}"
          </blockquote>

        </article>
      ))}
    </div>

  </div>
</section>
