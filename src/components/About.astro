---
/*
  About — Cobertura nacional, sectores, cifra destacada.
  Features sector tags and the "50+ organizaciones" stat.
*/

const sectors = [
  "Minería",
  "Construcción", 
  "Energía",
  "Industria",
  "Hidrocarburos",
  "Manufactura",
  "Servicios",
  "Transporte y Logística",
  "Salud",
  "Alimentos",
  "Tecnología",
  "Sector Público"
];
---

<section id="nosotros" class="section-padding bg-white">
  <div class="max-w-6xl 2xl:max-w-[90rem] 3xl:max-w-[110rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12">
    
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 2xl:gap-28 items-start" data-animate-group>
      
      <!-- Text content -->
      <div>
        <span class="text-gold-500 text-xs font-semibold tracking-widest uppercase font-sans mb-3 block" data-animate="fade-in" data-animate-order="0">Sobre nosotros</span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl text-navy-900 mb-6" data-reveal data-animate-order="1">
          Certificación acreditada, con cobertura a nivel nacional
        </h2>
        <p class="text-navy-900/70 text-base sm:text-lg 2xl:text-xl leading-relaxed mb-6" data-reveal-words data-animate-order="2">
          <strong class="font-bold text-navy-900">LBC Certification</strong> es un organismo de <strong class="font-bold text-navy-900">certificación de sistemas de gestión bajo normas ISO</strong>, representante en Perú de TNV Certification Pvt. Ltd., organismo acreditado por UAF (miembro de IAF). Contamos con presencia en todo el territorio peruano y brindamos servicios a organizaciones de todos los sectores y tamaños, bajo principios de imparcialidad, independencia y competencia técnica.
        </p>
        <p class="text-navy-900/70 text-base sm:text-lg 2xl:text-xl leading-relaxed mb-8" data-reveal-words data-animate-order="3">
          Nuestro equipo de auditores calificados acompaña a cada organización durante todo el proceso de certificación, desde la revisión documental hasta el seguimiento periódico del sistema de gestión.
        </p>

        <!-- Sector Tags -->
        <div class="mb-2" data-animate-order="4">
          <span class="text-navy-900/50 text-sm font-semibold uppercase tracking-wider mb-3 block">Sectores que atendemos</span>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3" data-animate-stagger="50">
            {sectors.map((sector) => (
              <span class="h-11 flex items-center justify-center px-3 text-sm font-sans font-semibold text-navy-700 bg-navy-50 rounded-md border border-silver-200 text-center whitespace-nowrap" data-animate="scale-in">
                {sector}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Stats / Visual Column -->
      <div class="flex flex-col items-center lg:items-start gap-8">
        <!-- Key Stat -->
        <div class="bg-navy-50 rounded-lg p-8 sm:p-10 w-full border border-silver-100" data-animate="fade-up" data-animate-order="2">
          <div class="flex items-start gap-5">
            <!-- Seal icon -->
            <div class="shrink-0 w-14 h-14 rounded-full bg-navy-900 flex items-center justify-center">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C4963C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 15l-2 5l1-3h2l1 3l-2-5z"/>
                <circle cx="12" cy="9" r="6"/>
                <path d="M12 3v2"/>
                <path d="M6.6 6.6l1.4 1.4"/>
                <path d="M3 12h2"/>
                <path d="M6.6 17.4l1.4-1.4"/>
                <path d="M17.4 6.6l-1.4 1.4"/>
                <path d="M21 12h-2"/>
                <path d="M17.4 17.4l-1.4-1.4"/>
              </svg>
            </div>
            <div>
              <span class="block font-serif text-4xl sm:text-5xl text-navy-900 mb-1">50<span class="text-gold-500">+</span></span>
              <span class="block text-navy-900/60 text-base font-sans">Organizaciones certificadas en todo el Perú</span>
            </div>
          </div>
        </div>

        <!-- Contact Info Card -->
        <div class="bg-white rounded-lg p-6 w-full border border-silver-200" data-animate="fade-up" data-animate-order="3">
          <div class="flex items-center gap-4">
            <div class="shrink-0 w-10 h-10 rounded-full bg-gold-500/10 flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C4963C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
            </div>
            <div>
              <span class="block text-sm text-navy-900/50 font-sans">WhatsApp / Teléfono</span>
              <a href="https://wa.me/51913233177" target="_blank" rel="noopener noreferrer" class="text-navy-900 font-semibold font-sans hover:text-gold-500 transition-colors">
                +51 913 233 177
              </a>
            </div>
          </div>
        </div>

        <!-- Cobertura Nacional Indicator -->
        <div class="flex items-center gap-3 text-navy-900/60" data-animate="fade-in" data-animate-order="4">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="text-sm font-sans font-semibold">Cobertura a nivel nacional — Perú</span>
        </div>
      </div>
    </div>
    <div class="mt-12 sm:mt-16 border-t border-silver-200 pt-8 sm:pt-10" data-animate="fade-up">
      <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
        <img
          src="/images/logos/LogoNeutralVeritas.jpeg"
          alt="Logo de TNV (Neutral Veritas Transparent)"
          width="410"
          height="409"
          loading="lazy"
          decoding="async"
          class="w-24 sm:w-28 h-auto shrink-0"
        />
        <div>
          <h3 class="font-serif text-2xl text-navy-900 mb-2">Franquicia de: TNV Global Limited</h3>
          <p class="max-w-2xl text-navy-900/70 leading-relaxed">
            TNV Global Limited es un organismo de certificación de sistemas de gestión
            acreditado por United Accreditation Foundation (UAF) para alcances específicos.
          </p>
        </div>
      </div>
      <div class="mt-8">
        <h3 class="font-serif text-xl text-navy-900 mb-4">Acreditación y reconocimiento de TNV</h3>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-silver-200 p-5">
            <img src="/images/logos/LogoUAF.jpeg" alt="Logo de UAF" width="394" height="184" loading="lazy" decoding="async" class="h-14 w-auto max-w-full object-contain" />
            <p class="mt-3 text-sm leading-relaxed text-navy-900/70">
              United Accreditation Foundation (UAF) acredita a TNV para alcances específicos de certificación.
            </p>
          </div>
          <div class="rounded-lg border border-silver-200 p-5">
            <img src="/images/logos/LogoIAF.jpeg" alt="Logo histórico de IAF" width="800" height="515" loading="lazy" decoding="async" class="h-14 w-auto max-w-full object-contain" />
            <p class="mt-3 text-sm leading-relaxed text-navy-900/70">
              International Accreditation Forum (IAF) gestionó el acuerdo multilateral de reconocimiento del que UAF fue signataria. Desde 2026, Global ACI continúa esa labor.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
