---

<section id="equipo" class="section-padding bg-white relative overflow-hidden">
  <!-- Subtle grid pattern -->
  <div class="absolute inset-0 opacity-[0.02]" aria-hidden="true">
    <div class="w-full h-full" style="background-image: linear-gradient(rgba(19,46,91,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(19,46,91,0.3) 1px, transparent 1px); background-size: 3rem 3rem;"></div>
  </div>

  <div class="relative max-w-7xl 2xl:max-w-[90rem] 3xl:max-w-[110rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12" data-animate-group>
    
    <div class="text-center mb-14">
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 mb-4 px-4 py-1.5 rounded-full border border-gold-500/30 bg-gold-500/10 shadow-sm" data-animate="fade-in" data-animate-order="0">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-500 animate-pulse" aria-hidden="true"></span>
        <span class="text-gold-600 text-xs 2xl:text-sm font-bold tracking-widest uppercase font-sans">Nuestro equipo</span>
      </div>

      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl text-navy-900 mb-4" data-reveal data-animate-order="1">
        Profesionales comprometidos con la excelencia
      </h2>
      <p class="text-navy-900/65 text-base sm:text-lg 2xl:text-xl max-w-3xl mx-auto font-sans leading-relaxed" data-reveal-words data-animate-order="2">
        Auditores y especialistas con amplia trayectoria multisectorial que garantizan evaluaciones técnicas, imparciales y de alto valor.
      </p>
    </div>

    <!-- Team Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 justify-center" data-animate-order="3" data-animate-stagger="80">
      {team.map((member) => (
        <article class="bg-navy-50/60 rounded-2xl p-6 sm:p-8 border border-silver-200/80 shadow-sm hover:shadow-lg hover:border-gold-500/40 transition-all duration-300 flex flex-col group relative overflow-hidden" data-animate="scale-in">
          
          <!-- Top subtle accent line on hover -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold-500/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <!-- Header with Avatar and Basic Info -->
          <div class="flex flex-col items-center text-center mb-6">
            <div class="relative mb-5">
              <div class="w-48 h-48 sm:w-52 sm:h-52 2xl:w-56 2xl:h-56 rounded-full overflow-hidden border-3 border-gold-500 shadow-xl ring-4 ring-gold-500/20 bg-navy-100">
                <img 
                  src={member.image} 
                  alt={member.name} 
                  class="w-full h-full object-cover select-none"
                  style={`object-position: ${member.objectPosition || 'center center'}; image-rendering: -webkit-optimize-contrast; image-rendering: auto; transform: translateZ(0); backface-visibility: hidden;`}
                  loading="eager"
                  decoding="async"
                />
              </div>
              <div class="absolute bottom-1 right-1 w-9 h-9 rounded-full bg-navy-900 border-2 border-white shadow-md flex items-center justify-center text-gold-400">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
            </div>

            <h3 class="font-serif text-xl sm:text-2xl text-navy-900 mb-1 font-normal">
              {member.name}
            </h3>
            
            <span class="text-gold-600 font-sans font-semibold text-xs sm:text-sm uppercase tracking-wider">
              {member.title}
            </span>
          </div>

          <!-- Credentials list -->
          <div class="pt-4 border-t border-silver-200/60 flex-1">
            <ul class="space-y-2.5 text-xs sm:text-[0.8125rem] text-navy-900/75 font-sans leading-relaxed">
              {member.credentials.map((cred) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-gold-500 mt-1.5 shrink-0" aria-hidden="true"></span>
                  <span>{cred}</span>
                </li>
              ))}
            </ul>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
