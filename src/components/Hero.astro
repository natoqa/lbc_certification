---
/*
  Hero — Full-width navy background with radial gradient.
  Centered content with DM Serif Display H1.
  Audit trail motif descends from bottom into next section.
*/
---

<section id="contenido-principal" class="relative bg-navy-900 overflow-hidden">
  <!-- Subtle radial gradient overlay for depth -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,_rgba(19,46,91,0.8)_0%,_transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_80%_80%,_rgba(19,46,91,0.5)_0%,_transparent_50%)]"
    aria-hidden="true"
  >
  </div>

  <!-- Subtle geometric pattern — audit grid lines fading in -->
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true">
    <div
      class="w-full h-full"
      style="background-image: linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 4rem 4rem;"
    >
    </div>
  </div>

  <div
    class="relative max-w-5xl 32inch:max-w-[105rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12 32inch:px-16 pt-32 pb-24 sm:pt-40 sm:pb-32 md:pt-44 md:pb-36 32inch:pt-56 32inch:pb-48"
  >
    <!-- Certification seal watermark -->
    <div
      class="absolute top-20 right-8 md:right-16 32inch:top-24 32inch:right-24 w-48 h-48 md:w-64 md:h-64 32inch:w-96 32inch:h-96 opacity-[0.04] 32inch:opacity-[0.06]"
      aria-hidden="true"
    >
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="100" cy="100" r="95" stroke="white" stroke-width="1.5"
        ></circle>
        <circle cx="100" cy="100" r="85" stroke="white" stroke-width="0.75"
        ></circle>
        <circle cx="100" cy="100" r="75" stroke="white" stroke-width="0.5"
        ></circle>
        <path
          d="M100 15 L105 30 L100 25 L95 30 Z"
          fill="white"
          transform="rotate(0, 100, 100)"></path>
        <path
          d="M100 15 L105 30 L100 25 L95 30 Z"
          fill="white"
          transform="rotate(45, 100, 100)"></path>
        <path
          d="M100 15 L105 30 L100 25 L95 30 Z"
          fill="white"
          transform="rotate(90, 100, 100)"></path>
        <path
          d="M100 15 L105 30 L100 25 L95 30 Z"
          fill="white"
          transform="rotate(135, 100, 100)"></path>
        <path
          d="M100 15 L105 30 L100 25 L95 30 Z"
          fill="white"
          transform="rotate(180, 100, 100)"></path>
        <path
          d="M100 15 L105 30 L100 25 L95 30 Z"
          fill="white"
          transform="rotate(225, 100, 100)"></path>
        <path
          d="M100 15 L105 30 L100 25 L95 30 Z"
          fill="white"
          transform="rotate(270, 100, 100)"></path>
        <path
          d="M100 15 L105 30 L100 25 L95 30 Z"
          fill="white"
          transform="rotate(315, 100, 100)"></path>
      </svg>
    </div>

    <div class="text-center">
      <!-- Small label above H1 -->
      <div
        class="inline-flex items-center gap-2 32inch:gap-3 mb-6 32inch:mb-8 px-4 32inch:px-6 py-1.5 32inch:py-2.5 rounded-full border border-gold-500/30 bg-gold-500/5"
      >
        <span
          class="w-1.5 h-1.5 32inch:w-2.5 32inch:h-2.5 rounded-full bg-gold-500"
          aria-hidden="true"></span>
        <span
          class="text-gold-400 text-xs 32inch:text-base font-semibold tracking-widest uppercase font-sans"
          >Organismo de Certificación de Sistemas de Gestión</span
        >
      </div>

      <h1
        class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[3.375rem] 32inch:text-7xl text-white leading-tight 32inch:leading-[1.15] max-w-4xl 32inch:max-w-6xl mx-auto mb-6 32inch:mb-10"
        data-reveal
      >
        Certificación acreditada de Sistemas de Gestión bajo Normas ISO
      </h1>

      <p
        class="text-silver-300 text-base sm:text-lg md:text-xl 32inch:text-2xl max-w-3xl 32inch:max-w-5xl mx-auto mb-10 32inch:mb-16 leading-relaxed font-sans"
        data-reveal-words
      >
        Proceso integral de certificación realizado por auditores competentes e imparciales: revisión documental, auditoría, emisión del certificado y seguimiento periódico, conforme a estándares internacionales.
      </p>

      <!-- CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 32inch:gap-6"
      >
        <a
          href="https://wa.me/51913233177"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-base 32inch:text-xl px-8 32inch:px-12 py-4 32inch:py-5 32inch:gap-3"
          id="hero-cta-whatsapp"
        >
          <svg
            width="20"
            height="20"
            class="32inch:w-6 32inch:h-6"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          Solicite su cotización
        </a>
        <a
          href="#servicios"
          class="btn-secondary text-base 32inch:text-xl px-8 32inch:px-12 py-4 32inch:py-5 32inch:gap-3"
        >
          Conozca nuestros servicios
          <svg
            width="16"
            height="16"
            class="32inch:w-5 32inch:h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12l7 7 7-7"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Audit trail descending into next section -->
    <div
      class="hidden md:flex flex-col items-center mt-16 32inch:mt-24"
      aria-hidden="true"
    >
      <div
        class="w-px h-16 32inch:h-24 bg-gradient-to-b from-transparent via-silver-400/40 to-silver-400/20"
      >
      </div>
      <div class="seal-node 32inch:w-5 32inch:h-5"></div>
    </div>
  </div>
</section>
