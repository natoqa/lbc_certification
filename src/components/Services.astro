---
/*
  Services — Hero card for general certification + 12 service cards.
  Each card is a semantic <article> with gold top-border (cert-card class).
  ISO numbers and full names are keyword-rich for SEO.
*/

const services = [
  {
    iso: "ISO 9001",
    name: "Gestión de la Calidad",
    description: "Fortalece la satisfacción de sus clientes y la eficiencia de sus procesos internos."
  },
  {
    iso: "ISO 14001",
    name: "Gestión Ambiental",
    description: "Reduce el impacto ambiental de sus operaciones y da cumplimiento a la normativa vigente."
  },
  {
    iso: "ISO 45001",
    name: "Seguridad y Salud en el Trabajo",
    description: "Previene lesiones y enfermedades laborales, protegiendo a sus colaboradores."
  },
  {
    iso: "ISO 37001",
    name: "Antisoborno",
    description: "Previene, detecta y aborda prácticas de soborno dentro de su organización."
  },
  {
    iso: "ISO 39001",
    name: "Seguridad Vial",
    description: "Reduce el riesgo de accidentes de tránsito asociados a su operación."
  },
  {
    iso: "ISO 50001",
    name: "Gestión de la Energía",
    description: "Mejora su desempeño energético y reduce costos operativos."
  },
  {
    iso: "ISO 55001",
    name: "Gestión de Activos",
    description: "Optimiza el valor y el rendimiento de sus activos a lo largo de su ciclo de vida."
  },
  {
    iso: "ISO 22000 / HACCP",
    name: "Inocuidad Alimentaria",
    description: "Garantiza la inocuidad de sus productos en toda la cadena alimentaria."
  },
  {
    iso: null,
    name: "Auditorías de Segunda Parte",
    description: "Evaluamos a sus proveedores y partes interesadas conforme a los criterios que su organización defina.",
    icon: "clipboard"
  },
  {
    iso: null,
    name: "Auditorías de Diagnóstico",
    description: "Identificamos brechas y oportunidades de mejora en su sistema de gestión antes de la auditoría de certificación.",
    icon: "search"
  },
  {
    iso: null,
    name: "Auditorías de Seguimiento y Recertificación",
    description: "Verificamos periódicamente el cumplimiento y mantenimiento de su sistema de gestión certificado.",
    icon: "refresh"
  },
  {
    iso: null,
    name: "Programas de Capacitación para Auditores Internos",
    description: "Formamos a su equipo en las competencias necesarias para realizar auditorías internas efectivas.",
    icon: "users"
  }
];
---

<section id="servicios" class="section-padding bg-navy-50">
  <div class="max-w-6xl 2xl:max-w-[90rem] 3xl:max-w-[110rem] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12" data-animate-group>
    
    <div class="text-center mb-12">
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 mb-5 px-4 py-1.5 rounded-full border border-gold-500/30 bg-gold-500/10 shadow-sm" data-animate="fade-in" data-animate-order="0">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-500 animate-pulse" aria-hidden="true"></span>
        <span class="text-gold-600 text-xs 2xl:text-sm font-bold tracking-widest uppercase font-sans">Nuestros servicios</span>
      </div>

      <!-- Section Title -->
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl text-navy-900 mb-5 leading-tight max-w-4xl mx-auto" data-reveal data-animate-order="1">
        Certificación acreditada, auditoría y formación en sistemas de gestión
      </h2>

      <!-- Highlighted Paragraph -->
      <p class="text-navy-900/75 text-lg sm:text-xl md:text-2xl max-w-4xl mx-auto font-sans leading-relaxed mb-8" data-reveal-words data-animate-order="2">
        Trabajamos con organizaciones de todos los sectores en sus procesos de <strong class="font-bold text-navy-900">certificación</strong>, <strong class="font-bold text-navy-900">evaluación de proveedores</strong> y <strong class="font-bold text-navy-900">fortalecimiento de sistemas de gestión</strong>, bajo principios de <strong class="font-bold text-navy-900">imparcialidad e independencia</strong>.
      </p>

      <!-- Pillars / Value Badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 max-w-4xl mx-auto mb-8" data-animate-order="3" data-animate-stagger="70">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-silver-200/80 shadow-sm text-xs sm:text-sm font-semibold text-navy-800 font-sans transition-all duration-300 hover:border-gold-500/50 hover:shadow" data-animate="fade-up">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C4963C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>Imparcialidad & Independencia</span>
        </div>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-silver-200/80 shadow-sm text-xs sm:text-sm font-semibold text-navy-800 font-sans transition-all duration-300 hover:border-gold-500/50 hover:shadow" data-animate="fade-up">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C4963C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
            <path d="M9 11l3 3L22 4"/>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
          </svg>
          <span>Evaluación de Conformidad</span>
        </div>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-silver-200/80 shadow-sm text-xs sm:text-sm font-semibold text-navy-800 font-sans transition-all duration-300 hover:border-gold-500/50 hover:shadow" data-animate="fade-up">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C4963C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 00-3-3.87"/>
            <path d="M16 3.13a4 4 0 010 7.75"/>
          </svg>
          <span>Formación Especializada</span>
        </div>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-silver-200/80 shadow-sm text-xs sm:text-sm font-semibold text-navy-800 font-sans transition-all duration-300 hover:border-gold-500/50 hover:shadow" data-animate="fade-up">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C4963C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 2a14.5 14.5 0 000 20 14.5 14.5 0 000-20"/>
            <path d="M2 12h20"/>
          </svg>
          <span>Cobertura Nacional</span>
        </div>
      </div>

      <!-- Accent Divider Line -->
      <div class="flex items-center justify-center gap-3" aria-hidden="true" data-animate="fade-in" data-animate-order="4">
        <div class="w-16 h-px bg-gradient-to-r from-transparent to-gold-500/50"></div>
        <div class="w-1.5 h-1.5 rotate-45 bg-gold-500"></div>
        <div class="w-16 h-px bg-gradient-to-l from-transparent to-gold-500/50"></div>
      </div>
    </div>

    <!-- Hero Service Card — General Certification -->
    <div class="mb-12 bg-navy-900 rounded-lg p-8 sm:p-10 text-white relative overflow-hidden" data-animate="fade-up" data-animate-order="5">
      <!-- Subtle pattern -->
      <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true">
        <div class="w-full h-full" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 3rem 3rem;"></div>
      </div>
      
      <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full border-2 border-gold-500 flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C4963C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                <path d="M22 4L12 14.01l-3-3"/>
              </svg>
            </div>
            <span class="text-gold-400 text-sm font-semibold tracking-wider uppercase font-sans">Servicio principal</span>
          </div>
          <h3 class="font-serif text-2xl sm:text-3xl mb-3" data-reveal>Certificación de Sistemas de Gestión ISO</h3>
          <p class="text-silver-300 text-base leading-relaxed max-w-2xl font-sans" data-reveal-words>
            Lo acompañamos en todo el proceso: desde la revisión documental y la auditoría en sitio, hasta la emisión del certificado. Todo a cargo de auditores calificados e imparciales, bajo estándares internacionales.
          </p>
        </div>
        <div class="flex flex-col items-start md:items-end gap-4 shrink-0">
          <div class="text-right">
            <span class="block text-silver-400 text-sm font-sans">Cotizaciones desde</span>
            <span class="block font-serif text-3xl text-white">S/1,200</span>
            <span class="block text-silver-400 text-xs font-sans">según alcance</span>
          </div>
          <a 
            href="https://wa.me/51913233177" 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn-primary"
            id="services-cta-whatsapp"
          >
            Solicite cotización
          </a>
        </div>
      </div>
    </div>

    <!-- Service Cards Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 3xl:grid-cols-6 gap-5 2xl:gap-6" data-animate-order="6" data-animate-stagger="60">
      {services.map((service) => (
        <article class="cert-card bg-white rounded-lg p-6 flex flex-col" data-animate="scale-in">
          {service.iso ? (
            <span class="text-gold-500 text-xs font-bold tracking-wider uppercase font-sans mb-2">{service.iso}</span>
          ) : (
            <span class="text-navy-700 text-xs font-bold tracking-wider uppercase font-sans mb-2">Servicio especializado</span>
          )}
          <h3 class="font-serif text-lg text-navy-900 mb-3 leading-snug">{service.name}</h3>
          <p class="text-navy-900/60 text-sm leading-relaxed font-sans flex-1">{service.description}</p>
        </article>
      ))}
    </div>

  </div>
</section>
