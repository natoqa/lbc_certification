---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "LBC Certification | Certificación ISO en Perú",
  description = "Certificación de sistemas de gestión ISO 9001, 14001, 45001 y más. Auditores calificados, proceso transparente, cobertura a nivel nacional. Cotiza gratis por WhatsApp."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="es_PE" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  
  <!-- Google Fonts: DM Serif Display + Source Sans 3 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
  
  <title>{title}</title>

  <slot name="head" />
</head>
<body class="bg-white text-navy-900 font-sans antialiased">
  <slot />
  <script src="../scripts/reveal-text.js"></script>
  <script src="../scripts/reveal-words.js"></script>
</body>
</html>
