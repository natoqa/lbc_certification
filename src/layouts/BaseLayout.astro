---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "LBC Certification | Certificación ISO en Perú",
  description = "Certificación de sistemas de gestión ISO 9001, 14001, 45001 y más. Auditores calificados, proceso transparente, cobertura a nivel nacional. Cotiza gratis por WhatsApp."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="author" content="LBC Certification S.A.C." />
  <meta name="theme-color" content="#0A1628" />

  <!-- Geolocation (SEO local — Perú) -->
  <meta name="geo.region" content="PE" />
  <meta name="geo.placename" content="Lima, Perú" />
  <meta name="geo.position" content="-12.0464;-77.0428" />
  <meta name="ICBM" content="-12.0464, -77.0428" />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL.href} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:site_name" content="LBC Certification" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL.href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="LBC Certification — Certificación ISO en Perú" />
  <meta property="og:locale" content="es_PE" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL.href} />
  <meta name="twitter:image:alt" content="LBC Certification — Certificación ISO en Perú" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <!-- Web App Manifest -->
  <link rel="manifest" href="/manifest.webmanifest" />
  
  <!-- Google Fonts: DM Serif Display + Source Sans 3 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
  
  <title>{title}</title>

  <slot name="head" />
</head>
<body class="bg-white text-navy-900 font-sans antialiased">
  <slot />
  <script src="../scripts/reveal-text.js"></script>
  <script src="../scripts/reveal-words.js"></script>
</body>
</html>
